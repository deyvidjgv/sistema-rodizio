{
  "rules": {
    ".read": false,
    ".write": false,

    "trabajadores": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (root.child('trabajadores').child(auth.uid).child('rolesPermitidos').hasChild('admin') || !root.child('trabajadores').exists())"
      }
    },

    "pedidos": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["ts", "estado"]
    },

    "contadores": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
